# Public Cloudinary configuration used for optimized delivery.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Server-only credentials used by Route Handlers. Never expose the secret.
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Namespace every managed demo asset and bound Admin API calls.
CLOUDINARY_PROJECT_FOLDER=visual-evals
CLOUDINARY_ADMIN_API_TIMEOUT_MS=5000
CLOUDINARY_IMAGE_GENERATION_TIMEOUT_MS=60000
CLOUDINARY_ANALYZE_API_TIMEOUT_MS=30000

# Optional public URL used for canonical metadata after deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
